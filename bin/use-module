#!/bin/bash
#
# Load one or more shell modules from modules/ next to this script.
# This file must be sourced: `source use-module <module> [module...]`.
#
# Tracks loaded modules in LOADED_MODULES (space-separated filenames
# without .sh). A module already listed is skipped.
#
# Loading runs at top level (not inside a function): bash would otherwise
# treat functions defined by sourced modules as local and drop them on return.
# Nested re-entry (a module doing `source use-module …`) uses a depth counter
# so each frame keeps its own status/name slots.

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  echo "error: use-module must be sourced (e.g. source use-module <module>)" >&2
  exit 1
fi

if [[ $# -lt 1 ]]; then
  echo "Usage: source use-module <module> [module...]" >&2
  return 1
fi

_USE_MODULE_SELF="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/${BASH_SOURCE[0]##*/}"
_USE_MODULE_DEPTH=$((${_USE_MODULE_DEPTH:-0} + 1))

eval "_um_status_${_USE_MODULE_DEPTH}=0"
LOADED_MODULES="${LOADED_MODULES:-}"

for _um_arg in "$@"; do
  if [[ " ${LOADED_MODULES} " == *" ${_um_arg} "* ]]; then
    continue
  fi

  _um_path="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/modules" && pwd)/${_um_arg}.sh"
  if [[ ! -f "${_um_path}" || ! -r "${_um_path}" ]]; then
    echo -e "${C_ERROR:-}Module \"${_um_arg}\" not found!${C_CLEAR:-}" >&2
    eval "_um_status_${_USE_MODULE_DEPTH}=1"
    continue
  fi

  eval "_um_loading_${_USE_MODULE_DEPTH}=\${_um_arg}"
  # shellcheck disable=SC1090
  if ! source "${_um_path}"; then
    eval "_um_status_${_USE_MODULE_DEPTH}=1"
    continue
  fi
  # Re-read depth slot after nested source use-module returns.
  eval "_um_loaded=\${_um_loading_${_USE_MODULE_DEPTH}}"
  LOADED_MODULES="${LOADED_MODULES:+${LOADED_MODULES} }${_um_loaded}"
done

# Shell-local only: exporting would survive reinit and skip sourcing, so
# functions would never be redefined while exported C_* vars still appear set.
# Nested source use-module in the same shell still sees this value.

# `use_module foo` as a simple command expands to a top-level source.
# (A real function that sources modules would hide those functions again.)
# shellcheck disable=SC2139
alias use_module="builtin source '${_USE_MODULE_SELF}'"

eval "_um_rc=\${_um_status_${_USE_MODULE_DEPTH}}"
eval "unset -v _um_status_${_USE_MODULE_DEPTH} _um_loading_${_USE_MODULE_DEPTH}"
_USE_MODULE_DEPTH=$((_USE_MODULE_DEPTH - 1))
(( _USE_MODULE_DEPTH == 0 )) && unset -v _USE_MODULE_DEPTH
return "${_um_rc}"
