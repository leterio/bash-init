#!/bin/bash
#
# Load one or more shell modules from modules/ next to this script.
# This file must be sourced: `source use-module <module> [module...]`.
#
# Tracks loaded modules in LOADED_MODULES (space-separated filenames
# without .sh). A module already listed is skipped.

if [[ $# -lt 1 ]]; then
  echo "Usage: source use-module <module> [module...]" >&2
  return 1
fi

#######################################
# Source modules from <use-module-dir>/modules if they are not already loaded.
# Globals:
#   LOADED_MODULES
# Arguments:
#   Module filenames without .sh.
# Returns:
#   0 if every module loaded or was already loaded, 1 if any is missing.
#######################################
function use_module() {
  local submodule
  local module_path
  local status=0
  local modules_dir
  modules_dir="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/modules" && pwd)"

  LOADED_MODULES="${LOADED_MODULES:-}"

  for submodule in "$@"; do
    if [[ " ${LOADED_MODULES} " == *" ${submodule} "* ]]; then
      continue
    fi

    module_path="${modules_dir}/${submodule}.sh"
    if [[ ! -f "${module_path}" || ! -r "${module_path}" ]]; then
      echo -e "${C_ERROR:-}Module \"${submodule}\" not found!${C_CLEAR:-}" >&2
      status=1
      continue
    fi
    # shellcheck disable=SC1090
    if ! source "${module_path}"; then
      status=1
      continue
    fi
    LOADED_MODULES="${LOADED_MODULES:+${LOADED_MODULES} }${submodule}"
  done

  export LOADED_MODULES
  return "${status}"
}

use_module "$@"
